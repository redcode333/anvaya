# Copy to k8s/secrets.env (gitignored) before `kubectl apply -k .`
# Generate tokens with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# Required: protects /metrics behind the Ingress; Prometheus reads the same value.
ANVAYA_METRICS_TOKEN=replace-with-a-random-token
# Required: Grafana admin password (anonymous users only get read-only Viewer access).
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password

# Optional: VerbX speech. Leave empty to use browser speech / text fallback.
VERBX_BASE_URL=
VERBX_API_KEY=

# Optional: LLM candidate-fact extraction (also set ANVAYA_LLM_EXTRACTION=on in kustomization.yaml).
# Free tiers: only demo/test sessions reach them unless LLM_ALLOW_REAL_DATA=true (see README, "LLM extraction").
GROQ_API_KEY=
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=   (only if "anthropic" is added to LLM_PROVIDERS; needs `pip install anthropic`)
