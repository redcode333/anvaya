# Copy to .env and fill in. Never commit real secrets.

# --- Database (see README "Database"). Unset = SQLite file (ANVAYA_DB below): local dev, tests, CI, offline kiosk.
# Set = PostgreSQL, e.g. Supabase via its *Session pooler* (Dashboard → Connect → Session pooler; IPv4, port 5432):
#   DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# TLS is required automatically (sslmode=require) unless the URL sets sslmode. The URL holds the database password:
# it is never logged, and /api/v1/ready only says "postgres". Tests ignore it (they use TEST_DATABASE_URL, a local
# throwaway Postgres such as `docker run -e POSTGRES_PASSWORD=... -p 5432:5432 postgres:16`).
DATABASE_URL=
# Connections per app process (Supabase's free Session pooler allows few clients; keep this small).
# ANVAYA_DB_POOL_MAX=5
# Seconds between checks of whether in-memory copies of rules / catalogue facets / TTS stats are still current.
# ANVAYA_DB_CACHE_CHECK_S=5

# --- VerbX translation + speech (STT/TTS); see docs/vendor/verbx.md.
# Leave blank to use browser speech / text input and English scheme names.
VERBX_BASE_URL=https://api.verbxeco.com
VERBX_API_KEY=
VERBX_SHELL=saas
VERBX_TTS_VOICE=verbx-female
VERBX_TIMEOUT_S=15
# Read-aloud waits at most this long per sentence; slower syntheses finish in the background into the audio cache.
ANVAYA_TTS_WAIT_S=8

# --- Optional LLM candidate-fact extraction (never decides eligibility; see README "LLM extraction").
# Deterministic extraction always runs and stays primary. The LLM only adds unconfirmed candidates or cross-checks;
# with every provider down (or unset) the app behaves exactly as with ANVAYA_LLM_EXTRACTION=off.
ANVAYA_LLM_EXTRACTION=off
# Providers in fallback order (timeout / 429 / 5xx / invalid output -> next one). Names: groq, gemini, ollama,
# anthropic (optional; needs `pip install anthropic`). Each NAME uses NAME_BASE_URL, NAME_API_KEY, NAME_MODEL,
# NAME_DAILY_REQUESTS (soft cap per day, 0 = none) and optionally NAME_REASONING_EFFORT.
LLM_PROVIDERS=groq,gemini

# Groq (free tier: requests/day and tokens/minute limits). OpenAI-compatible: https://console.groq.com/docs/openai
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_DAILY_REQUESTS=900
GROQ_REASONING_EFFORT=low

# Google Gemini (free tier; daily quota resets at midnight Pacific). https://ai.google.dev/gemini-api/docs/openai
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_DAILY_REQUESTS=0
# "low" keeps answers within the 6 s call timeout; the model's default thinking often takes longer.
GEMINI_REASONING_EFFORT=low

# Local Ollama (add "ollama" to LLM_PROVIDERS; no key needed). https://docs.ollama.com/api/openai-compatibility
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3:8b

# Optional Anthropic provider (not the default).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Per-call timeout and total LLM budget per conversation turn (seconds; the budget includes the VerbX translation).
LLM_CALL_TIMEOUT_S=6
LLM_TURN_BUDGET_S=7
# Circuit breaker: this many consecutive failures -> skip the provider for LLM_CIRCUIT_OPEN_S seconds.
LLM_CIRCUIT_FAILURES=5
LLM_CIRCUIT_OPEN_S=60
# Privacy: free-tier providers may receive demo/test data only. false = the LLM runs only for TC-runner sessions,
# sessions created with "demo": true, and the kiosk's built-in demo phrases. Set true only for a provider whose terms
# allow real citizen data.
LLM_ALLOW_REAL_DATA=false

# --- Optional Langfuse tracing of LLM extraction (one trace per LLM turn; input/output for demo/test data only,
# metadata only otherwise). Leave any of the three unset to disable: the SDK is then never imported.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com   # EU; US: https://us.cloud.langfuse.com (LANGFUSE_HOST also accepted)
# LANGFUSE_TIMEOUT_S=2                           # export HTTP timeout; export runs in the background
# LANGFUSE_TRACING_ENVIRONMENT=development       # Langfuse environment label (SDK setting)
# LANGFUSE_TRACE_EVAL=1                          # eval-extraction also pushes a dataset + one experiment per config

# --- Supabase Auth (README "Accounts and modes"). Server side: token verification + admin API (secret key: server only,
# never logged, never sent to the browser). Unset SUPABASE_URL = no staff sign-in / accounts; Passport code + PIN works.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Browser side (baked into the frontend build; sign-in only): the same project URL and the *publishable* key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
GOOGLE_AUTH_ENABLED=false
# SUPABASE_JWKS_CACHE_S=600
# Cloudflare Turnstile *site* key (public). The secret key goes only into Supabase (Auth -> Attack Protection ->
# CAPTCHA). Unset = no widget (local dev only).
VITE_TURNSTILE_SITE_KEY=
# Staff API calls need a TOTP-verified (aal2) token. false only for a local demo without MFA.
# ANVAYA_STAFF_MFA_REQUIRED=true
# Per-IP limits per minute: session creation / Passport resume, and browser auth-event reports.
# ANVAYA_SESSION_CREATE_LIMIT=20
# ANVAYA_AUTH_EVENT_LIMIT=30
# Phone OTP via Supabase phone auth: Indian SMS needs DLT registration and a paid SMS provider.
PHONE_OTP_ENABLED=false

# DigiLocker / Meri Pehchaan (OAuth 2.0 / OIDC, code + PKCE). Needs partner onboarding; every value comes from it.
DIGILOCKER_ENABLED=false
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_AUTH_URL=
DIGILOCKER_TOKEN_URL=
DIGILOCKER_JWKS_URL=
DIGILOCKER_REDIRECT_URI=
DIGILOCKER_SCOPES=openid
# DIGILOCKER_ISSUER=

# Staff accounts in Supabase Auth, created/updated by `python -m anvaya.manage seed-staff` (role -> app_metadata).
# Passwords: at least 8 characters. There are no demo passwords.
ANVAYA_ADMIN_EMAIL=
ANVAYA_ADMIN_PASSWORD=
ANVAYA_REVIEWER_EMAIL=
ANVAYA_REVIEWER_PASSWORD=
ANVAYA_OPERATOR_EMAIL=
ANVAYA_OPERATOR_PASSWORD=

# Saved passports. Pepper for Passport code hashes: python -c "import secrets; print(secrets.token_urlsafe(32))"
ANVAYA_PASSPORT_PEPPER=
PASSPORT_RETENTION_DAYS=365
# ANVAYA_UNSAVED_RETENTION_HOURS=24
# ANVAYA_RETENTION_INTERVAL_MIN=60   # retention runs in the app this often; 0 = only `manage cleanup`
KIOSK_IDLE_SECONDS=180
KIOSK_MAX_SESSION_MINUTES=30

# Document uploads: private Supabase Storage bucket (create it, private), reached only by the backend.
# SUPABASE_STORAGE_BUCKET=documents
REVIEWED_UPLOAD_RETENTION_DAYS=30

# Scheduled jobs: POST /internal/jobs/run needs this in the X-Internal-Token header (unset = the endpoint is 404).
# Also set it, and APP_URL, as GitHub repository secrets for .github/workflows/scheduled-jobs.yml.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_JOBS_TOKEN=

# --- Metrics: when set, GET /metrics needs "Authorization: Bearer <token>" (the bundled Prometheus configs send none).
# ANVAYA_METRICS_TOKEN=

# --- App settings
ANVAYA_RULE_BUNDLE_VERSION=rules-2026.10.1
ANVAYA_SESSION_TTL_HOURS=12
ANVAYA_CASE_CODE_TTL_HOURS=72
ANVAYA_CODE_LOOKUP_LIMIT=10
# on = anyone may run/reset the TC1–TC5 scenarios (demo kiosks); off = admin sign-in required.
ANVAYA_DEMO_TEST_RUNS=off
# ANVAYA_DB=backend/instance/anvaya.db
# ANVAYA_DATASET=data/raw/structured_govt_schemes_converted.csv

# --- Grafana admin (applied when Grafana's data volume is first created)
GRAFANA_ADMIN_PASSWORD=change-me
# true = anyone can view the dashboards read-only without signing in (local demo); false = sign-in required.
GRAFANA_ANONYMOUS=true

# Sign-in options still being integrated: off | coming_soon | on (read at runtime via GET /api/config).
# Until "on", their API routes answer 503 FEATURE_NOT_AVAILABLE.
DIGILOCKER_STATUS=coming_soon
PHONE_OTP_STATUS=coming_soon
# Cloudflare Turnstile public site key (optional)
TURNSTILE_SITE_KEY=
