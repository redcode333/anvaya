# Copy to .env and fill in. Never commit real secrets.

# --- VerbX speech (STT/TTS). Leave blank to use browser speech / text fallback.
VERBX_BASE_URL=
VERBX_API_KEY=
# Reconcile these paths with the VerbX API docs supplied by the organizers.
VERBX_STT_PATH=/v1/stt
VERBX_TTS_PATH=/v1/tts
VERBX_TIMEOUT_S=15

# --- Optional LLM candidate-fact extraction (never decides eligibility).
ANVAYA_LLM_EXTRACTION=off
ANTHROPIC_API_KEY=
ANVAYA_LLM_MODEL=claude-opus-5-5

# --- App settings
ANVAYA_RULE_BUNDLE_VERSION=rules-2026.10.1
ANVAYA_SESSION_TTL_HOURS=12
ANVAYA_CASE_CODE_TTL_HOURS=72
ANVAYA_CODE_LOOKUP_LIMIT=10
# on = anyone may run/reset the TC1–TC4 scenarios (demo kiosks); off = admin sign-in required.
ANVAYA_DEMO_TEST_RUNS=off
# ANVAYA_DB=backend/instance/anvaya.db
# ANVAYA_DATASET=data/raw/structured_govt_schemes_converted.csv

# --- Grafana admin (anonymous users get read-only Viewer access)
GRAFANA_ADMIN_PASSWORD=change-me
