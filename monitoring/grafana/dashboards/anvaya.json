    {
      "type": "timeseries",
      "title": "Screenings vs confirmation blocks",
      "description": "Blocked = screening refused because high-impact facts (age, income, state, household) were unconfirmed.",
      "targets": [
        {
          "expr": "sum(rate(anvaya_eligibility_evaluations_total[1m])) * 60",
          "legendFormat": "screenings / min",
          "refId": "A"
        },
        {
          "expr": "rate(anvaya_screening_blocked_total[1m]) * 60",
          "legendFormat": "blocked until confirmed / min",
          "refId": "B"
